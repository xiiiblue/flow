---
import Shell from '../layouts/Shell.astro';
import source from '../data/source.json';
const b=import.meta.env.BASE_URL;
const firstReads=[
 {slug:'introduction',number:'01',title:'HiveFlow是什么',text:'开发者反馈怎样进入全自动开发流水线。'},
 {slug:'workflow',number:'02',title:'看一条反馈怎样处理',text:'用一个导出问题，走过调查、决定、修改和反馈结果。'},
 {slug:'owner-commands',number:'03',title:'看一次完整对话',text:'开发者怎样反馈，任务怎样自动推进，Director怎样介入。'},
];
const modes=[
 {start:'manual',delivery:'pr_review',eyebrow:'你发起任务 / 先审代码',title:'改好以后，等你审阅',text:'你指定要解决的问题。开发助手完成修改和检查，提交PR（代码审阅请求）后停止，由你决定后续合并、部署。',count:'你需要发起任务，并在PR完成后决定下一步。'},
 {start:'manual',delivery:'full_delivery',eyebrow:'你发起任务 / 完整交付',title:'按约定完成修改和验收',text:'你说清改什么、发布到哪个环境、怎样算完成。开发助手按要求完成审阅、修改、合并、部署和验收，再报告结果。',count:'通常说清一次即可；新的重要决定仍由你处理。'},
 {start:'scheduled',delivery:'pr_review',eyebrow:'按计划启动 / 先审代码',title:'自动准备修改，仍等你审阅',text:'负责人先批准并启用任务计划。Hermes每次安排一项任务，开发助手提交PR后停止，等待你决定后续合并、部署。',count:'不用逐单发起，每份PR仍需要你处理。'},
 {start:'scheduled',delivery:'full_delivery',eyebrow:'按计划启动 / 完整交付',title:'在批准的范围内逐项完成',text:'负责人先规定项目、环境、运行时间、任务数量和停止条件。Hermes核对每项任务后安排开发，完成一项再处理下一项。',count:'范围内连续推进；条件不满足时停止并说明原因。'},
];
---
<Shell>
  <main id="main">
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="eyebrow"><span></span>面向开发者反馈循环的全自动开发流水线</p>
        <h1>开发者反馈，<br/><span class="accent">流水线交付。</span></h1>
        <p class="lead">HiveFlow是全自动开发流水线。<br/>从群里的开发者反馈，到调查、开发、检查和交付，<br class="desktop"/>目标是让日常研发自动推进，减少人工转交、催办和逐步确认。</p>
        <div class="actions"><a class="button primary" href="#process">看一个例子 <span>↓</span></a><a class="text-link" href={b+'read/overview/'}>从这里开始阅读 ↗</a></div>
        <p class="hero-note"><span class="status-dot"></span>流水线持续推进 · Director保留“踩刹车”的权力</p>
      </div>
      <div class="flow-board" aria-label="开发者反馈循环示例：反馈导出缺陷，流水线调查和整理，在批准范围内自动开发、检查和交付，再回到原群；Director可暂停或叫停。">
        <div class="board-title"><span>“导出的文件怎么只有第一页？”</span><span class="mono">一个示例</span></div>
        <div class="board-track">
          <div><i>01</i><strong>开发者在群里反馈</strong><small>流水线自动调查、查重并整理Issue</small></div><span>↓</span>
          <div><i>02</i><strong>在批准范围内自动开发</strong><small>实现、测试、审阅和修正接着完成</small></div><span>↓</span>
          <div><i>03</i><strong>交付后回到原群</strong><small>报告发布和验收结果，继续接收反馈</small></div>
        </div>
        <div class="board-return"><span>↶</span> 反馈回到开发者手上：<br/><b>现在能导出全部结果了吗？</b></div>
        <p class="board-caption">教学示例 · Director可暂停、调整范围或叫停。</p>
      </div>
    </section>

    <section class="section wrap" id="process">
      <div class="section-top"><p class="eyebrow">先看一件具体的事</p><h2>一句“帮忙看看”，<br/>后面还有不少工作。</h2><p>开发者在使用和开发中发现问题，<br/>反馈进入流水线，改动交付后回到开发者手上，<br/>新的反馈再进入下一轮。</p></div>
      <div class="comparison">
        <article><span class="mono">开发者反馈</span><h3>“我选了整个月，怎么只导出一页？”</h3><p>助手先问清操作过程，检查这是使用方式的问题，还是软件确实有缺陷。如果说明用法就能解决，直接答复；确实需要修改，再整理成一条待处理的问题记录。</p></article>
        <article class="flow-vision"><span class="mono">需要修改时</span><h3>从“发现缺陷”继续做到“确认修好”</h3><p>符合采纳和执行条件的任务，在预先批准的范围内自动推进：修改代码、运行检查、完成必要审阅，按约定发布和验收，再将处理结果带回原开发者群。</p></article>
      </div>
      <div class="principles">
        <div><span>01 / 自动衔接</span><h3>减少人来回转交任务</h3><p>调查、问题记录、实现和交付沿同一项任务接着做，让人少复制上下文、少派单、少催进度。</p></div>
        <div><span>02 / 连续推进</span><h3>范围说清后，少逐步确认</h3><p>Director先明确目标、权限和停止条件。符合条件的日常任务连续推进，减少每一步都要人到场的等待。</p></div>
        <div><span>03 / 反馈循环</span><h3>交付结果回到开发者手上</h3><p>开发者能看到修改、检查和发布结果，继续试用和反馈，让下一轮改进接着发生。</p></div>
      </div>
      <a class="text-link" href={b+'read/workflow/'}>沿着这个例子继续读 →</a>
    </section>

    <section class="reuse-section section wrap" id="reuse">
      <div class="section-top"><p class="eyebrow">谁来做这些工作</p><h2>把现有工具，<br/>接成开发流水线。</h2><p>Hermes协调任务，Codex完成开发，<br/>GitHub保存问题和代码，<br/>企业微信承接开发者反馈与结果通知。</p></div>
      <div class="capability-grid">
        <article><span class="mono">沟通</span><h3>企业微信</h3><p>开发者在项目群里反馈缺陷、提出改进、补充复现步骤，并查看处理结果。</p><small>普通问题可以直接在原会话里答复。</small></article>
        <article><span class="mono">调查与协调</span><h3>Hermes</h3><p>接收反馈、调查问题、整理待办，并在负责人批准的范围内安排远程开发助手。</p><small>群里的助手使用QueenBee这个名字。</small></article>
        <article><span class="mono">问题与代码记录</span><h3>GitHub</h3><p>Issue用来记录待处理的问题；PR用来提交代码，供人审阅。两者帮助大家找到同一项工作的进展。</p><small>创建了问题记录，还需要决定是否实施。</small></article>
        <article><span class="mono">开发与检查</span><h3>Codex</h3><p>AI编程助手，负责查代码、修改和运行检查。也可以由负责人直接在自己的电脑上协同使用。</p><a href={b+'read/adapters/'}>详细了解人和工具怎样配合 →</a></article>
      </div>
    </section>

    <section class="delivery-section section" id="delivery"><div class="wrap">
      <div class="section-top"><p class="eyebrow">负责人怎样安排任务</p><h2>先说清楚，<br/>这次要做到哪一步。</h2><p>可以先改好代码等你审阅，<br/>也可以按约定完成发布和验收。<br/>任务由你发起，或由获准的计划启动，都能这样选择。</p></div>
      <div class="delivery-grid">{modes.map(mode=><article data-start={mode.start} data-delivery={mode.delivery}><p class="eyebrow">{mode.eyebrow}</p><h3>{mode.title}</h3><p>{mode.text}</p><div class="director-count">{mode.count}</div></article>)}</div>
      <div class="delivery-note"><strong>完整交付让任务连续推进，PR待审让你主动保留一道审阅。</strong><p>日常任务在批准范围内自动完成；需要亲自验收或出现新的重要决定时，由Director介入。上面的参与次数只讨论开发阶段，源头采纳和计划配置另外计算。</p><a class="text-link" href={b+'read/delivery/'}>详细了解两种交付方式 →</a></div>
    </div></section>

    <section class="usage-section section wrap" id="guide">
      <div class="section-top"><p class="eyebrow">开发者怎样参与反馈循环</p><h2>说出你在做什么，<br/>哪里没有达到预期。</h2><p>在管理员接入并授权的工作群里，<br/>@本群实际使用的助手即可。<br/>描述复现步骤、预期结果和影响范围即可。</p></div>
      <div class="usage-examples"><article><span>问用法</span><p>@助手 我想把本月的记录导出来，应该从哪里操作？</p></article><article><span>报问题</span><p>@助手 选了整个月再导出，文件仍只有第一页。预期是全部结果。</p></article><article><span>提需求</span><p>@助手 每周都要手工整理记录，希望能按日期一次导出。</p></article></div>
      <div class="usage-bottom"><p>助手可能继续询问操作步骤或出现时间。问题被记下后，还需要负责人决定是否修改；回复会写明已经完成的工作和下一步。</p><a class="button primary" href={b+'read/user-guide/'}>查看反馈问题的例子 ↗</a></div>
    </section>

    <section class="state-section" id="version"><div class="wrap state-grid">
      <div><p class="eyebrow">Director怎样“踩刹车”</p><h2>日常任务自动走，<br/>关键时刻停得下。</h2><p>尽可能把人从重复流转中抽离出来。<br/>Director保留对方向、范围和风险的控制。</p><a class="text-link" href={b+'read/automation/'}>了解连续运行、停止和恢复 →</a></div>
      <div class="state-table">
        <div><span class="state-label">定范围</span><h3>先决定什么可以自动做</h3><p>明确项目、环境、运行时间、任务数量、交付方式和停止条件。流水线据此处理符合条件的任务。</p></div>
        <div><span class="state-label pending">踩刹车</span><h3>随时暂停、调整或叫停</h3><p>方向偏离、风险扩大或不希望继续时，Director可以要求停止。流水线停止相应后续动作，并核对在途请求和已有结果。</p></div>
        <div><span class="state-label neutral">再继续</span><h3>从已有结果恢复</h3><p>核对停在了哪里、哪些动作已经完成。恢复范围明确后接着做，避免重新开发或重复发布、通知。</p></div>
      </div>
    </div></section>

    <section class="section wrap" id="reading">
      <div class="section-top"><p class="eyebrow">第一次阅读</p><h2>先看懂流水线，<br/>再看具体怎么做。</h2><p>不用从头读完所有章节。<br/>先读下面三篇，就能了解主要过程。</p></div>
      <div class="book-list">{firstReads.map(page=><a href={b+'read/'+page.slug+'/'}><span class="mono">{page.number}</span><h3>{page.title}</h3><p>{page.text}</p><span class="book-arrow">↗</span></a>)}</div>
      <div class="reading-foot"><a href={b+'read/overview/'}>查看全部阅读内容 →</a><a href={b+'read/acceptance/'}>准备接入自己的项目 →</a><a href={b+'read/glossary/'}>查术语和常见问题 →</a></div>
    </section>

    <section class="family-band" id="why"><div class="wrap">
      <div class="section-top"><p class="eyebrow">项目背景</p><h2>来自蜂巢项目的<br/>日常研发实践。</h2><p>HiveFlow在蜂巢项目中形成。<br/>想了解相关产品和研发方法，可以继续看这里。</p></div>
      <div class="family-grid">
        <a href="https://www.bluexiii.com/hive/" class="family-item"><span class="mono">产品</span><h3>蜂巢 <span>↗</span></h3><strong>让AI助手参与日常工作</strong><p>提供对话、文件、工具和工作环境。</p></a>
        <a href="https://www.bluexiii.com/acdl/" class="family-item"><span class="mono">研发方法</span><h3>ACDL <span>↗</span></h3><strong>怎样组织软件研发</strong><p>说明需求、设计、实施、评审和版本怎样安排。</p></a>
        <div class="family-item current"><span class="mono">全自动开发流水线</span><h3>HiveFlow</h3><strong>怎样让开发者反馈自动走到交付</strong><p>安排反馈调查、负责人决定、开发和结果通知。</p></div>
      </div>
    </div></section>

    <section class="closing wrap" id="source"><p class="eyebrow">继续了解</p><h2>从一个具体问题开始。</h2><p>公开项目<a class="text-link" href="https://github.com/xiiiblue/hive-flow">hive-flow ↗</a>提供参考规则与离线工具，采用<a class="text-link" href={source.publicProject.licenseUrl}>Apache-2.0</a>。内容核对：{source.reviewedOn}。</p><a class="button primary" href={b+'read/overview/'}>开始阅读 ↗</a></section>
  </main>
</Shell>
