---
import Shell from './Shell.astro';
import source from '../data/source.json';
const {frontmatter,headings=[]}=Astro.props;
const b=import.meta.env.BASE_URL;
const entrySlugs=['overview','introduction','workflow','owner-commands','user-guide'];
const entries=entrySlugs.map(slug=>source.pages.find(page=>page.slug===slug));
const chapters=source.pages.filter(page=>page.kind!=='topic'&&!entrySlugs.includes(page.slug)&&page.slug!=='contributing');
const maintenance=source.pages.find(page=>page.slug==='contributing');
const topics=source.pages.filter(page=>page.kind==='topic');
---
<Shell title={frontmatter.title+' · HiveFlow'}>
  <main id="main" class="reader wrap">
    <aside class="sidebar">
      <a class="back" href={b+'#reading'}>← 返回阅读入口</a>
      <details class="chapter-menu" open>
        <summary>浏览手册目录 <span aria-hidden="true">⌄</span></summary>
        <p class="nav-label">第一次阅读</p>
        <nav aria-label="入门阅读">
          {entries.map(page=><a href={b+'read/'+page.slug+'/'} aria-current={Astro.url.pathname===b+'read/'+page.slug+'/'?'page':undefined}>{page.title}</a>)}
        </nav>
        <p class="nav-label">接入与运行细节</p>
        <nav aria-label="接入与运行细节">
          {chapters.map(page=><a href={b+'read/'+page.slug+'/'} aria-current={Astro.url.pathname===b+'read/'+page.slug+'/'?'page':undefined}><span class="chapter-number">{page.number}</span>{page.title}</a>)}
        </nav>
        <p class="nav-label">专题阅读</p>
        <nav aria-label="专题阅读">
          {topics.map(page=><a href={b+'read/'+page.slug+'/'} aria-current={Astro.url.pathname===b+'read/'+page.slug+'/'?'page':undefined}>{page.title}</a>)}
        </nav>
        <p class="nav-label">网站维护</p>
        <nav aria-label="网站维护"><a href={b+'read/contributing/'} aria-current={Astro.url.pathname===b+'read/contributing/'?'page':undefined}>{maintenance.title}</a></nav>
      </details>
      <p class="fine">内容核对：{source.reviewedOn}<br/>实际接入情况见验证记录。</p>
    </aside>
    <div class="reader-body">
      <div class="reader-kicker">HIVEFLOW / 阅读与查阅</div>
      <article class="prose"><slot/></article>
      <div class="source-note">
        <p>依据HiveFlow介绍手册整理 · 来源版本 <code>{source.commit.slice(0,8)}</code> · 内容核对：{source.reviewedOn}</p>
        <details><summary>查看内容来源与适用范围</summary>
          <p>本站可独立阅读，无需访问私有仓库。网站不替代执行规范；实际任务按目标项目的当前规则和授权处理。教学示例不代表真实交付记录。</p>
          <p>维护顺序：规范→介绍→网站→独立副本。上游手册状态为Review；具体来源、原始摘要和网页对应章节保存在来源记录中。</p>
          <a href="https://github.com/xiiiblue/flow/blob/main/src/data/handbook.md">原手册公开目录 ↗</a> · <a href="https://github.com/xiiiblue/flow/blob/main/src/data/source.json">查看来源记录 ↗</a>
        </details>
      </div>
      <a class="text-link" href={b+'#reading'}>← 选择下一篇手册</a>
    </div>
    <aside class="toc"><strong>本页目录</strong>{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</aside>
  </main>
</Shell>
<script>
  const menu=document.querySelector<HTMLDetailsElement>('.chapter-menu');
  const mobile=matchMedia('(max-width: 720px)');
  const sync=()=>{if(menu)menu.open=!mobile.matches;};
  sync();
  mobile.addEventListener('change',sync);
</script>
